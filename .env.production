# PNF-AIMS Production Environment
# This file contains production-specific configuration
# IMPORTANT: Never commit this file to version control
# Store sensitive values in a secure vault (AWS Secrets Manager, Azure Key Vault, etc.)

# ============================================================
# DEPLOYMENT ENVIRONMENT
# ============================================================
NODE_ENV=production
PORT=3000

# ============================================================
# API ENDPOINT
# ============================================================
# Your production backend URL (include https)
VITE_API_BASE_URL=https://api.your-production-domain.com

# ============================================================
# PROVIDER API KEYS (Production)
# ============================================================
# Replace with your actual production keys

# ElevenLabs - Voice synthesis (REQUIRED)
# Get from: https://elevenlabs.io/app/settings/api-keys
VITE_ELEVENLABS_API_KEY=sk_your_production_key_here

# Suno AI - Music generation (Optional)
VITE_SUNO_API_KEY=your_suno_production_key_here

# Mureka - Music generation (Optional)
VITE_MUREKA_API_KEY=your_mureka_production_key_here

# Udio - Music generation (Optional)
VITE_UDIO_API_KEY=your_udio_production_key_here

# ============================================================
# AUTHENTICATION (If required by your backend)
# ============================================================
VITE_AUTH_TOKEN=your_auth_token_here

# ============================================================
# LOGGING & MONITORING
# ============================================================
# Set to true to enable debug logging
DEBUG=false

# Sentry error tracking (optional)
SENTRY_DSN=https://your-sentry-key@sentry.io/project-id

# ============================================================
# RATE LIMITING & TIMEOUTS
# ============================================================
# Request timeout in milliseconds
VITE_REQUEST_TIMEOUT=30000

# Maximum concurrent generation requests
MAX_CONCURRENT_REQUESTS=20

# ============================================================
# SESSION & STORAGE
# ============================================================
# Maximum session size in KB (default 2048 = 2MB)
MAX_SESSION_SIZE_KB=2048

# Number of sessions to keep in local storage (default 20)
MAX_SAVED_SESSIONS=20

# ============================================================
# SECURITY HEADERS
# ============================================================
# Enable HTTPS only mode
HTTPS_ONLY=true

# CORS allowed origins (comma-separated)
CORS_ORIGINS=https://your-production-domain.com,https://www.your-production-domain.com

# ============================================================
# PERFORMANCE TUNING
# ============================================================
# Enable gzip compression
GZIP_ENABLED=true

# FFT analysis interval (milliseconds)
FFT_ANALYSIS_INTERVAL=30

# Web Audio buffer size (samples)
AUDIO_BUFFER_SIZE=4096

# ============================================================
# DEPLOYMENT NOTES
# ============================================================
# 1. This file should NOT be committed to version control
# 2. Use environment variable injection for deployment automation
# 3. Rotate API keys quarterly
# 4. Keep a secure backup of this configuration
# 5. Monitor API usage and billing
# 6. Set up alerts for failed generation requests
# 7. Enable CDN for static assets
# 8. Use a reverse proxy (nginx/Caddy) for HTTPS termination
# 9. Implement rate limiting at the proxy level
# 10. Set up automated backups and disaster recovery
